BARK_URL=
NTFY_SERVER_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
GENERIC_WEBHOOK_URL=
GENERIC_WEBHOOK_TEMPLATE=

# --- Email ---
EMAIL_FROM=
EMAIL_PASSWORD=
